generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum ModuleType {
  PDF
  VIDEO
  QUIZ
}

enum QuizAttemptStatus {
  IN_PROGRESS
  COMPLETED
}

enum StudySessionStatus {
  IN_PROGRESS
  COMPLETED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  coursesCreated    Course[]              @relation("CourseCreator")
  visibilities      CourseVisibility[]
  attempts          QuizAttempt[]
  studySessions     StudySession[]
  uploadedTemplates TemplateLibraryFile[]

  @@map("users")
}

model Course {
  id             String   @id @default(uuid())
  title          String
  description    String?
  about          String? // long-form "about this course" shown on the overview tab
  targetAudience String? // who this course is for, shown on the overview tab
  coverUrl       String?
  active         Boolean  @default(true)
  createdById    String
  createdBy      User     @relation("CourseCreator", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  modules       Module[]
  visibilities  CourseVisibility[]
  studySessions StudySession[]

  @@map("courses")
}

// Course enrollment: which students have access to a given course. Individual
// rows, added/removed one at a time — never replaced wholesale (see
// CoursesService.addStudents/removeStudent and UsersService.addCourses/removeCourse).
model CourseVisibility {
  id         String   @id @default(uuid())
  courseId   String
  userId     String
  assignedAt DateTime @default(now())
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
  @@map("course_visibilities")
}

model Module {
  id            String     @id @default(uuid())
  courseId      String
  course        Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type          ModuleType
  title         String
  coverUrl      String?
  visible       Boolean    @default(true)
  order         Float      @default(0) // orders modules within a course
  studyPriority Int        @default(3) // 1 (low) - 5 (high), feeds the study-schedule recommendation score
  createdAt     DateTime   @default(now())

  pdfItems      PdfItem[]
  videoItems    VideoItem[]
  questions     Question[]
  attempts      QuizAttempt[]
  studySessions StudySession[]

  @@map("modules")
}

model PdfItem {
  id         String   @id @default(uuid())
  moduleId   String
  module     Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title      String
  fileUrl    String
  fileKey    String // key in the S3/R2 bucket, used to delete later
  sizeBytes  BigInt?
  orderLabel String // "1", "1.1", "2" — shown in the UI
  orderNum   Float // 1.0, 1.1, 2.0 — used for ORDER BY
  createdAt  DateTime @default(now())

  @@index([moduleId, orderNum])
  @@map("pdf_items")
}

model VideoItem {
  id          String   @id @default(uuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  fileUrl     String // streaming URL (Cloudflare Stream/Mux) or storage URL
  fileKey     String?
  durationSec Int?
  orderLabel  String
  orderNum    Float
  createdAt   DateTime @default(now())

  @@index([moduleId, orderNum])
  @@map("video_items")
}

model Question {
  id           String   @id @default(uuid())
  moduleId     String
  module       Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  statement    String
  timeLimitSec Int      @default(205) // 3min25s
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  options QuestionOption[]
  answers AttemptAnswer[]

  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  letter     String // A, B, C, D, E, F...
  text       String
  correct    Boolean  @default(false)

  selectedBy AttemptAnswer[]

  @@unique([questionId, letter])
  @@map("question_options")
}

model QuizAttempt {
  id           String            @id @default(uuid())
  moduleId     String
  module       Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       QuizAttemptStatus @default(IN_PROGRESS)
  startedAt    DateTime          @default(now())
  completedAt  DateTime?
  totalCorrect Int?
  totalWrong   Int?
  totalTimeSec Int?
  archived     Boolean           @default(false) // true once superseded by a retry

  answers AttemptAnswer[]

  @@index([moduleId, userId, archived])
  @@map("quiz_attempts")
}

model AttemptAnswer {
  id         String      @id @default(uuid())
  attemptId  String
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // FK, not a letter — set on submit, validated against the question it belongs to.
  // SetNull so an instructor editing a question's options later can't be blocked
  // by an old student answer still pointing at a deleted option row.
  selectedOptionId String?
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  // null while IN_PROGRESS — correctness is computed once, at finish() time only,
  // so it never has to be withheld/filtered before that on the way out of the API
  correct Boolean?

  // set once, the first time the student ever opens this question — never reset
  // on revisit, so the countdown survives reload/navigation without restarting
  questionStartedAt DateTime?
  // last time selectedOptionId was set (or cleared) — updated on every change
  answeredAt        DateTime?
  elapsedSeconds    Int?
  overtimeSeconds   Int?

  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}

// One in-progress-or-completed study "block" of time a user spends on a
// single module. Strictly individual (never shared/aggregated across users)
// and short-lived by design: COMPLETED rows older than 14 days are purged by
// StudySessionRetentionService — this table is a rolling recent-activity log,
// not a permanent record (unlike QuizAttempt/QuizResult, which are kept forever).
model StudySession {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId        String
  module          Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  status          StudySessionStatus @default(IN_PROGRESS)
  startedAt       DateTime           @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId, status])
  @@index([userId, courseId])
  @@index([status, endedAt])
  @@map("study_sessions")
}

// Reusable administrative files (quiz-import templates, and generically any
// other doc/csv/json/pdf/docx an admin/instructor wants available to
// download again later) — stored in the same R2 bucket as course content but
// under a separate key prefix, with its own model/endpoints/permissions so it
// never mixes with educational Course PDFs.
model TemplateLibraryFile {
  id           String   @id @default(uuid())
  name         String
  description  String?
  originalName String
  storageKey   String
  mimeType     String
  fileSize     Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
  @@map("template_library_files")
}
