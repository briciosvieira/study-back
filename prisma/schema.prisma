generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum ModuleType {
  PDF
  VIDEO
  QUIZ
}

enum QuizAttemptStatus {
  IN_PROGRESS
  COMPLETED
}

enum StudySessionStatus {
  IN_PROGRESS
  COMPLETED
}

enum PolicyAcceptanceStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Minimal, reusable grant system — deliberately not a full RBAC engine.
// ADMIN gets both implicitly via role check (never stored, never revocable
// by another admin); this is only for granting them to INSTRUCTOR/STUDENT.
enum Permission {
  VIEW_AUDIT_LOGS
  EXPORT_AUDIT_LOGS
  MANAGE_POLICY_REACTIVATION
}

model User {
  id                 String       @id @default(uuid())
  name               String
  email              String       @unique
  username           String       @unique
  passwordHash       String
  role               Role
  active             Boolean      @default(true)
  avatarStorageKey   String? // opaque R2 object key (avatars/<uuid>-avatar.<ext>) — never derived from name/email
  mustChangePassword Boolean      @default(false) // set true when an admin/instructor resets someone else's password
  permissions        Permission[] @default([]) // grants beyond role defaults — ADMIN's own access is role-based, never stored here
  createdAt          DateTime     @default(now())

  coursesCreated    Course[]               @relation("CourseCreator")
  visibilities      CourseVisibility[]
  attempts          QuizAttempt[]
  studySessions     StudySession[]
  uploadedTemplates TemplateLibraryFile[]
  policyAcceptances UserPolicyAcceptance[]
  studyTreesCreated StudyTree[]            @relation("StudyTreeCreator")
  treeChecks        UserTreeCheck[]

  @@map("users")
}

// Immutable once published — editing a policy's text means publishing a new
// version, never mutating an existing row. isActive marks the single
// currently-presented version; requiresReacceptance controls whether users
// who accepted an older version must accept this one again (see
// AccountAccessService).
model PolicyVersion {
  id                   String   @id @default(uuid())
  version              String   @unique
  title                String
  content              String
  isActive             Boolean  @default(false)
  requiresReacceptance Boolean  @default(false)
  publishedAt          DateTime
  createdAt            DateTime @default(now())

  acceptances UserPolicyAcceptance[]

  @@index([isActive])
  @@map("policy_versions")
}

// One row per user tracking their current decision on the policy — this is
// the source of truth for access control (never AuditEvent, which is
// retention-limited to 30 days and must not gate login). A user's *history*
// of decisions across versions isn't modeled here; only the latest decision
// matters for access, and prior decisions remain visible via AuditEvent for
// as long as that 30-day window lasts.
model UserPolicyAcceptance {
  id              String                 @id @default(uuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  policyVersionId String
  policyVersion   PolicyVersion          @relation(fields: [policyVersionId], references: [id])
  status          PolicyAcceptanceStatus @default(PENDING)

  acceptedAt DateTime?
  rejectedAt DateTime?

  // reconsideration deadline — set once on rejection, never reset by a
  // later login; null while ACCEPTED/PENDING or while paused below
  scheduledDeletionAt DateTime?

  // set only while an ADMIN has isActive=false on this user during an
  // active rejection countdown — the remaining time is preserved here and
  // scheduledDeletionAt is cleared, so the countdown can't run out while the
  // user is administratively blocked from reconsidering
  deletionPausedAt         DateTime?
  deletionRemainingSeconds Int?

  // Consolidated-account review hold (accounts >= ESTABLISHED_ACCOUNT_DAYS
  // old) — a completely separate mechanism from scheduledDeletionAt above.
  // While policyReviewUntil is set, this account never auto-deletes; only an
  // explicit admin decision (approve/deny reactivation, or manual delete)
  // clears it. reactivationRequestedAt is set when the user re-accepts
  // during the hold, but that alone never restores access — see
  // PolicyService.accept()/approveReactivation().
  policyReviewStartedAt   DateTime?
  policyReviewUntil       DateTime?
  reactivationRequestedAt DateTime?
  reactivatedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, policyVersionId])
  @@index([userId])
  @@index([status])
  @@index([scheduledDeletionAt])
  @@index([policyReviewUntil])
  @@map("user_policy_acceptances")
}

// HMAC of a normalized email, never the email itself in the unique/lookup
// column — see EmailEligibilityService. Soft-removable: removedAt != null
// means an ADMIN cleared the block and the address is eligible again.
model EmailBlocklist {
  id          String  @id @default(uuid())
  emailHash   String  @unique
  maskedEmail String?
  reason      String

  createdAt   DateTime  @default(now())
  removedAt   DateTime?
  removedById String?

  @@index([removedAt])
  @@map("email_blocklist")
}

// Append-only — no update/delete path exists anywhere in the app. Never
// cascades from User: a deleted user's events must remain queryable for the
// rest of the 30-day retention window, so actor/target are plain historical
// strings, not live foreign keys.
model AuditEvent {
  id        String @id @default(uuid())
  eventType String
  category  String
  severity  String

  actorUserId String?
  actorName   String?

  targetUserId      String?
  targetName        String?
  targetEmailMasked String?

  resourceType String?
  resourceId   String?

  method     String?
  route      String?
  httpStatus Int?

  ipAddress String?
  userAgent String?
  requestId String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([eventType])
  @@index([category])
  @@index([severity])
  @@index([actorUserId])
  @@index([httpStatus])
  @@map("audit_events")
}

// An aggregated, deduplicated view over a burst of related AuditEvents —
// repeated occurrences within SECURITY_INCIDENT_WINDOW_SECONDS increment the
// same row instead of creating a new one (see SecurityIncidentService).
model SecurityIncident {
  id       String @id @default(uuid())
  type     String
  severity String

  userId    String?
  ipAddress String?

  route  String?
  method String?

  occurrenceCount Int @default(1)

  firstOccurredAt DateTime
  lastOccurredAt  DateTime

  createdAt DateTime @default(now())

  notifications AuditNotification[]

  @@index([createdAt])
  @@index([severity])
  @@index([type])
  @@map("security_incidents")
}

// Per-viewer read state for an incident — never a single boolean on the
// incident itself, since each ADMIN/auditor tracks their own unread state.
model AuditNotification {
  id         String           @id @default(uuid())
  userId     String
  incidentId String
  incident   SecurityIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  readAt           DateTime?
  popupDismissedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, incidentId])
  @@index([userId])
  @@map("audit_notifications")
}

// One row per successfully-archived UTC day — the retention job checks this
// before deleting that day's AuditEvent rows from Postgres, so a failed R2
// upload can never silently take the only copy of a day's events with it.
model AuditArchiveLog {
  id          String   @id @default(uuid())
  archiveDate DateTime
  eventCount  Int
  storageKey  String
  createdAt   DateTime @default(now())

  @@unique([archiveDate])
  @@map("audit_archive_logs")
}

model Course {
  id             String   @id @default(uuid())
  title          String
  description    String?
  about          String? // long-form "about this course" shown on the overview tab
  targetAudience String? // who this course is for, shown on the overview tab
  coverUrl       String?
  active         Boolean  @default(true)
  // nullable so a deleted instructor/admin account never blocks or orphans
  // the course they created — content they authored is shared, not personal
  // data, and must survive their account being permanently deleted
  createdById    String?
  createdBy      User?    @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  modules       Module[]
  visibilities  CourseVisibility[]
  studySessions StudySession[]
  studyTree     StudyTree?

  @@map("courses")
}

// Course enrollment: which students have access to a given course. Individual
// rows, added/removed one at a time — never replaced wholesale (see
// CoursesService.addStudents/removeStudent and UsersService.addCourses/removeCourse).
model CourseVisibility {
  id         String   @id @default(uuid())
  courseId   String
  userId     String
  assignedAt DateTime @default(now())
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
  @@map("course_visibilities")
}

model Module {
  id            String     @id @default(uuid())
  courseId      String
  course        Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type          ModuleType
  title         String
  coverUrl      String?
  visible       Boolean    @default(true)
  order         Float      @default(0) // orders modules within a course
  studyPriority Int        @default(3) // 1 (low) - 5 (high), feeds the study-schedule recommendation score
  createdAt     DateTime   @default(now())

  pdfItems      PdfItem[]
  videoItems    VideoItem[]
  questions     Question[]
  attempts      QuizAttempt[]
  studySessions StudySession[]

  @@map("modules")
}

model PdfItem {
  id          String   @id @default(uuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  fileUrl     String
  fileKey     String // key in the S3/R2 bucket, used to delete later
  sizeBytes   BigInt?
  orderLabel  String // "1", "1.1", "2" — shown in the UI
  orderNum    Float // 1.0, 1.1, 2.0 — used for ORDER BY
  createdAt   DateTime @default(now())

  studySessions StudySession[]

  @@index([moduleId, orderNum])
  @@map("pdf_items")
}

model VideoItem {
  id          String   @id @default(uuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  fileUrl     String // streaming URL (Cloudflare Stream/Mux) or storage URL
  fileKey     String?
  durationSec Int?
  orderLabel  String
  orderNum    Float
  createdAt   DateTime @default(now())

  studySessions StudySession[]

  @@index([moduleId, orderNum])
  @@map("video_items")
}

model Question {
  id           String   @id @default(uuid())
  moduleId     String
  module       Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  statement    String
  timeLimitSec Int      @default(205) // 3min25s
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  options QuestionOption[]
  answers AttemptAnswer[]

  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  letter     String // A, B, C, D, E, F...
  text       String
  correct    Boolean  @default(false)

  selectedBy AttemptAnswer[]

  @@unique([questionId, letter])
  @@map("question_options")
}

model QuizAttempt {
  id           String            @id @default(uuid())
  moduleId     String
  module       Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       QuizAttemptStatus @default(IN_PROGRESS)
  startedAt    DateTime          @default(now())
  completedAt  DateTime?
  totalCorrect Int?
  totalWrong   Int?
  totalTimeSec Int?
  archived     Boolean           @default(false) // true once superseded by a retry

  answers AttemptAnswer[]

  @@index([moduleId, userId, archived])
  @@map("quiz_attempts")
}

model AttemptAnswer {
  id         String      @id @default(uuid())
  attemptId  String
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // FK, not a letter — set on submit, validated against the question it belongs to.
  // SetNull so an instructor editing a question's options later can't be blocked
  // by an old student answer still pointing at a deleted option row.
  selectedOptionId String?
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  // null while IN_PROGRESS — correctness is computed once, at finish() time only,
  // so it never has to be withheld/filtered before that on the way out of the API
  correct Boolean?

  // set once, the first time the student ever opens this question — never reset
  // on revisit, so the countdown survives reload/navigation without restarting
  questionStartedAt DateTime?
  // last time selectedOptionId was set (or cleared) — updated on every change
  answeredAt        DateTime?
  elapsedSeconds    Int?
  overtimeSeconds   Int?

  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}

// One in-progress-or-completed study "block" of time a user spends on a
// single module. Strictly individual (never shared/aggregated across users)
// and short-lived by design: COMPLETED rows older than 14 days are purged by
// StudySessionRetentionService — this table is a rolling recent-activity log,
// not a permanent record (unlike QuizAttempt/QuizResult, which are kept forever).
model StudySession {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId        String
  module          Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  // Optional individual resource within the module — nullable so existing
  // rows (and QUIZ-type sessions, which have no sub-item) stay valid as-is.
  // SetNull so deleting a PdfItem/VideoItem later never breaks a past session.
  pdfItemId       String?
  pdfItem         PdfItem?           @relation(fields: [pdfItemId], references: [id], onDelete: SetNull)
  videoItemId     String?
  videoItem       VideoItem?         @relation(fields: [videoItemId], references: [id], onDelete: SetNull)
  status          StudySessionStatus @default(IN_PROGRESS)
  startedAt       DateTime           @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId, status])
  @@index([userId, courseId])
  @@index([status, endedAt])
  @@map("study_sessions")
}

// Reusable administrative files (quiz-import templates, and generically any
// other doc/csv/json/pdf/docx an admin/instructor wants available to
// download again later) — stored in the same R2 bucket as course content but
// under a separate key prefix, with its own model/endpoints/permissions so it
// never mixes with educational Course PDFs.
model TemplateLibraryFile {
  id           String   @id @default(uuid())
  name         String
  description  String?
  originalName String
  storageKey   String
  mimeType     String
  fileSize     Int
  // nullable so a deleted admin/instructor account never blocks or orphans
  // a template they uploaded — same reasoning as Course.createdById
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
  @@map("template_library_files")
}

// One shared subject map per course (never per-user — see UserTreeCheck for
// the individual part). @unique on courseId is what enforces "at most one
// tree per course" at the DB level, not just in application code.
model StudyTree {
  id          String   @id @default(uuid())
  courseId    String   @unique
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // nullable so a deleted admin account never blocks or orphans the tree
  // they imported — same reasoning as Course.createdById
  createdById String?
  createdBy   User?    @relation("StudyTreeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  nodes StudyTreeNode[]

  @@map("study_trees")
}

// Generic recursive hierarchy (parent/children) — deliberately not a fixed
// subject/topic/subtopic shape, so depth is unlimited. `code` comes straight
// from the imported spreadsheet's node_code column and is only ever used to
// resolve parent_code references during import; kept on the row for
// traceability. A node with no children is a leaf and is the only kind that
// can carry a UserTreeCheck — enforced in application code (StudyTreeService),
// not by the schema itself.
model StudyTreeNode {
  id       String   @id @default(uuid())
  treeId   String
  tree     StudyTree @relation(fields: [treeId], references: [id], onDelete: Cascade)
  code     String
  parentId String?
  parent   StudyTreeNode?  @relation("StudyTreeNodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children StudyTreeNode[] @relation("StudyTreeNodeChildren")
  title    String
  order    Int      @default(0)
  createdAt DateTime @default(now())

  checks UserTreeCheck[]

  @@unique([treeId, code])
  @@index([treeId, parentId])
  @@map("study_tree_nodes")
}

// Deliberately temporary, per-user state — NOT a history table. A row only
// exists while its 5-day window is still running: checking creates it,
// unchecking or expiring deletes it (see StudyTreeService/
// StudyTreeCheckCleanupJob). The database never accumulates more rows than
// there are currently-active checks across all users, regardless of how many
// times someone has checked/unchecked over time.
model UserTreeCheck {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId    String
  node      StudyTreeNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  checkedAt DateTime      @default(now())
  expiresAt DateTime

  @@unique([userId, nodeId])
  @@index([expiresAt])
  @@map("user_tree_checks")
}
