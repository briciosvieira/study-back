# ── App ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3100
FRONTEND_URL=http://localhost:5100

# Production values (replace with your actual deployed frontend domain):
# PORT=3100
# FRONTEND_URL=https://app.example.com

# ── Database ───────────────────────────────────────────────
# Must reference the same user/password/db as POSTGRES_* below if you're
# using the bundled docker-compose Postgres service for local dev.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Only consumed by docker-compose.yml to provision the local Postgres
# container — keep in sync with the credentials embedded in DATABASE_URL.
POSTGRES_DB=CHANGE_ME
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# ── Redis (used by BullMQ) ───────────────────────────────────
# Local docker-compose: leave username/password empty, tls=false.
# Redis Cloud (or any managed Redis): fill in host/port/password from your
# instance's connection details; set REDIS_TLS=true if it requires TLS.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

# ── JWT ────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=300m
JWT_REFRESH_SECRET=CHANGE_ME
JWT_REFRESH_EXPIRES_IN=7d

# ── Initial seed (admin) ──────────────────────────────────────
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@lms.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME

# ── Storage (S3 or Cloudflare R2 — S3-compatible SDK) ─────────
STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=YOUR_BUCKET
STORAGE_ACCESS_KEY_ID=YOUR_ACCESS_KEY
STORAGE_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_URL=https://YOUR_PUBLIC_STORAGE_URL
STORAGE_PRESIGN_EXPIRES_SEC=900

# Optional: a separate, genuinely private bucket for audit archives. The
# bucket above is public (pub-*.r2.dev) for course content, which is not
# appropriate for audit data — set this to a bucket with NO public access
# configured. If left empty, audit archives fall back to the main bucket
# (a startup warning is logged in that case).
STORAGE_AUDIT_BUCKET=

# Local dev alternative: point the STORAGE_* values above at the bundled
# docker-compose MinIO service instead of a real R2/S3 bucket:
#   STORAGE_ENDPOINT=http://localhost:9000
#   STORAGE_ACCESS_KEY_ID=<same value as MINIO_ROOT_USER below>
#   STORAGE_SECRET_ACCESS_KEY=<same value as MINIO_ROOT_PASSWORD below>
#   STORAGE_PUBLIC_URL=http://localhost:9000/<STORAGE_BUCKET>

# Only consumed by docker-compose.yml to provision the local MinIO container.
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME

# ── Local uploads (course covers) ─────────────────────────────
# Relative to the process working directory by default. In Docker/production,
# point this at a mounted volume so files survive redeploys, e.g. /data/uploads.
UPLOADS_DIR=uploads

# ── Policy acceptance ──────────────────────────────────────
# Days a user has to reconsider after rejecting the policy before their
# account is permanently deleted. Only applies to accounts younger than
# ESTABLISHED_ACCOUNT_DAYS — see below.
POLICY_RECONSIDERATION_DAYS=7

# An account this old (or older) is "consolidated": rejecting/withdrawing the
# policy never triggers automatic deletion for it, only an administrative
# review hold (POLICY_REVIEW_HOLD_DAYS) that a human must ultimately resolve.
ESTABLISHED_ACCOUNT_DAYS=90

# Days a consolidated account's review hold stays open before it becomes
# PENDING_ADMIN_DECISION. The account is never auto-deleted at the end of
# this window — an admin (or a MANAGE_POLICY_REACTIVATION holder) must
# explicitly reactivate, keep it blocked, or delete it.
POLICY_REVIEW_HOLD_DAYS=30

# ── Audit & security ───────────────────────────────────────
# Days AuditEvent/SecurityIncident/R2 archives are retained before deletion.
AUDIT_RETENTION_DAYS=30
# Failed-attempt thresholds within SECURITY_INCIDENT_WINDOW_SECONDS that
# escalate a SecurityIncident's severity.
SECURITY_WARNING_ATTEMPTS=3
SECURITY_HIGH_ATTEMPTS=5
SECURITY_CRITICAL_ATTEMPTS=10
SECURITY_INCIDENT_WINDOW_SECONDS=300

# Server-side secret used to HMAC emails before storing them in the deletion
# blocklist — never the plain email. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_BLOCKLIST_HMAC_KEY=CHANGE_ME
