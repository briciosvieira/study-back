# ── App ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3100
FRONTEND_URL=http://localhost:5100

# Production values (replace with your actual deployed frontend domain):
# PORT=3100
# FRONTEND_URL=https://app.example.com

# ── Database ───────────────────────────────────────────────
# Must reference the same user/password/db as POSTGRES_* below if you're
# using the bundled docker-compose Postgres service for local dev.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Only consumed by docker-compose.yml to provision the local Postgres
# container — keep in sync with the credentials embedded in DATABASE_URL.
POSTGRES_DB=CHANGE_ME
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# ── Redis (used by BullMQ) ───────────────────────────────────
# Local docker-compose: leave username/password empty, tls=false.
# Redis Cloud (or any managed Redis): fill in host/port/password from your
# instance's connection details; set REDIS_TLS=true if it requires TLS.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

# ── JWT ────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=300m
JWT_REFRESH_SECRET=CHANGE_ME
JWT_REFRESH_EXPIRES_IN=7d

# ── Initial seed (admin) ──────────────────────────────────────
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@lms.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME

# ── Storage (S3 or Cloudflare R2 — S3-compatible SDK) ─────────
STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=YOUR_BUCKET
STORAGE_ACCESS_KEY_ID=YOUR_ACCESS_KEY
STORAGE_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_URL=https://YOUR_PUBLIC_STORAGE_URL
STORAGE_PRESIGN_EXPIRES_SEC=900

# Local dev alternative: point the STORAGE_* values above at the bundled
# docker-compose MinIO service instead of a real R2/S3 bucket:
#   STORAGE_ENDPOINT=http://localhost:9000
#   STORAGE_ACCESS_KEY_ID=<same value as MINIO_ROOT_USER below>
#   STORAGE_SECRET_ACCESS_KEY=<same value as MINIO_ROOT_PASSWORD below>
#   STORAGE_PUBLIC_URL=http://localhost:9000/<STORAGE_BUCKET>

# Only consumed by docker-compose.yml to provision the local MinIO container.
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME

# ── Local uploads (course covers) ─────────────────────────────
# Relative to the process working directory by default. In Docker/production,
# point this at a mounted volume so files survive redeploys, e.g. /data/uploads.
UPLOADS_DIR=uploads
